# Never use VITE_* for secrets. Copy to .env.admin.local (gitignored).
ADMIN_ORIGIN=http://127.0.0.1:5173
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3001
# Generate using a cryptographic password manager or node crypto.randomBytes(32).
ADMIN_MFA_ENCRYPTION_KEY=
# Production: NODE_ENV=production, exact HTTPS ADMIN_ORIGIN, trusted proxy CIDRs only.
ADMIN_TRUST_PROXY=
