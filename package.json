{
  "name": "iax-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "overrides": { "minimatch": "^11.0.1" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:all": "concurrently -k npm:dev npm:server:dev",
    "server:dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server scripts/admin.mjs scripts/admin-cleanup.mjs scripts/db/check.mjs tests vite.config.ts playwright.config.ts",
    "test:security": "node --test tests/server/*.test.mjs",
    "admin:create": "node scripts/admin.mjs create",
    "admin:disable": "node scripts/admin.mjs disable",
    "admin:enable": "node scripts/admin.mjs enable",
    "admin:reset-password": "node scripts/admin.mjs reset-password",
    "admin:revoke-sessions": "node scripts/admin.mjs revoke-sessions",
    "admin:reset-mfa": "node scripts/admin.mjs reset-mfa",
    "admin:cleanup": "node scripts/admin-cleanup.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "db:setup": "node scripts/db/migrate.mjs",
    "db:check": "node scripts/db/check.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "framer-motion": "^12.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "otplib": "^13.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.0"
  }
}
